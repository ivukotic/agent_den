# Copy to .env and fill in real values. .env is git-ignored — never commit it.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Inside docker-compose, "postgres" and "redis" are the service names.
DATABASE_URL=postgres://agent_den:change-me@postgres:5432/agent_den
REDIS_URL=redis://redis:6379

POSTGRES_USER=agent_den
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agent_den

# The real hostname this is served from (see README > Discoverability plan).
# Deliberately NOT the placeholder used elsewhere in this repo's docs.
PUBLIC_HOSTNAME=agent-den.example
